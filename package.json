{
  "name": "@lando/leia",
  "description": "Runs tests cleverly hidden in documentation",
  "version": "1.0.0-beta.9",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando/leia.git"
  },
  "bugs": "https://github.com/lando/leia/issues/new/choose/",
  "homepage": "https://github.com/lando/leia",
  "keywords": [
    "lando",
    "leia",
    "mocha",
    "testing"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/lib/leia.js",
  "bin": {
    "leia": "dist/bin/leia.js"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "check:toolchain": "bun run tooling/scripts/check-toolchain-task.ts",
    "dev": "bun --watch run app/bin/leia.ts",
    "leia": "bun run app/bin/leia.ts",
    "lint": "bun run lint:eslint && bun run format:check",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun --bun node_modules/mocha/bin/mocha.js --timeout 5000 \"{app,tooling}/test/**/*.spec.ts\"",
    "build": "bun run tooling/scripts/build-cli.ts",
    "watch": "bun run tooling/scripts/build-cli.ts --watch",
    "check:build": "bun run tooling/scripts/check-build-task.ts",
    "test:leia": "bun run build && bun run leia README.md \"examples/**/*.md\" -i \"examples/basic-cmd-example.md\" -i \"examples/exclude-example/**/*.md\" -i \"examples/stdin-example.md\" -i \"examples/custom-headers.md\" -i \"examples/environment.md\" -i \"examples/basic-pwsh-example.md\"",
    "test:leia:stdin": "bun run leia examples/stdin-example.md --stdin",
    "lint:eslint": "eslint --config eslint.config.mjs .",
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "test:lifecycle": "bun run build && node examples/lifecycle/verify.cjs"
  },
  "dependencies": {
    "@lando/chai": "npm:chai@^4.4.1",
    "chalk": "^4.1.2",
    "debug": "^4.3.2",
    "detect-newline": "^3.1.0",
    "glob": "^7.1.3",
    "lodash": "^4.17.11",
    "marked": "^4.0.10",
    "mocha": "^11.1.0",
    "object-hash": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.3.14",
    "@types/debug": "^4.1.13",
    "@types/glob": "7",
    "@types/lodash": "^4.17.25",
    "@types/marked": "4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/object-hash": "^3.0.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "packageManager": "bun@1.3.14",
  "type": "commonjs"
}
