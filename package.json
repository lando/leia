{
  "name": "@lando/leia",
  "description": "Runs tests cleverly hidden in documentation",
  "version": "1.0.0-beta.9",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando/leia.git"
  },
  "bugs": "https://github.com/lando/leia/issues/new/choose/",
  "homepage": "https://github.com/lando/leia",
  "keywords": [
    "lando",
    "leia",
    "mocha",
    "oclif",
    "testing"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "lib/leia.js",
  "bin": {
    "leia": "bin/leia"
  },
  "files": [
    "/bin",
    "/cli",
    "/lib",
    "/templates"
  ],
  "nyc": {
    "include": [
      "lib/*.js"
    ],
    "exclude": [
      "test/**",
      "bin/**"
    ],
    "cache": true,
    "all": true
  },
  "oclif": {
    "bin": "leia",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "check:toolchain": "bun run tooling/scripts/check-toolchain-task.ts",
    "dev": "bun --watch run app/bin/leia.ts",
    "leia": "bun run app/bin/leia.ts",
    "lint": "bun run lint:eslint && bun run format:check",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun run test:legacy && bun run test:typescript",
    "build": "bun run tooling/scripts/build-cli.ts",
    "watch": "bun run tooling/scripts/build-cli.ts --watch",
    "check:build": "bun run tooling/scripts/check-build-task.ts",
    "test:leia": "bun run leia README.md \"examples/**/*.md\" -i \"examples/basic-cmd-example.md\" -i \"examples/exclude-example/**/*.md\" -i \"examples/stdin-example.md\" -i \"examples/custom-headers.md\" -i \"examples/environment.md\" -i \"examples/basic-pwsh-example.md\"",
    "test:leia:stdin": "bun run leia examples/stdin-example.md --stdin",
    "lint:eslint": "eslint --config eslint.config.mjs . bin/leia",
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "test:legacy": "nyc --reporter=html --reporter=text mocha --timeout 5000 test/*.spec.js",
    "test:typescript": "bun --bun node_modules/mocha/bin/mocha.js \"{app,tooling}/test/**/*.spec.ts\""
  },
  "dependencies": {
    "@lando/argv": "^1.0.6",
    "@lando/chai": "npm:chai@^4.4.1",
    "@oclif/command": "^1.8.0",
    "@oclif/config": "^1.17.0",
    "@oclif/errors": "^1.3.5",
    "@oclif/plugin-help": "^3.2.3",
    "chalk": "^4.1.2",
    "command-line-test": "^1.0.10",
    "debug": "^4.3.2",
    "detect-newline": "^3.1.0",
    "dot": "^1.1.2",
    "fs-extra": "^7.0.1",
    "glob": "^7.1.3",
    "lodash": "^4.17.11",
    "marked": "^4.0.10",
    "mocha": "^11.1.0",
    "object-hash": "^2.2.0"
  },
  "devDependencies": {
    "@oclif/dev-cli": "^1.26.0",
    "@oclif/test": "^1.2.8",
    "eslint": "^10.10.0",
    "mock-fs": "^4.7.0",
    "nyc": "^15.1.0",
    "typescript": "~5.9.3",
    "@types/bun": "1.3.14",
    "@types/node": "^24.0.0",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.57.1",
    "@types/mocha": "^10.0.10"
  },
  "packageManager": "bun@1.3.14",
  "type": "commonjs"
}
