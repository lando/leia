{
  "name": "@lando/leia",
  "description": "Runs tests cleverly hidden in documentation",
  "version": "1.0.0-beta.9",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando/leia.git"
  },
  "bugs": "https://github.com/lando/leia/issues/new/choose/",
  "homepage": "https://github.com/lando/leia",
  "keywords": [
    "lando",
    "leia",
    "mocha",
    "oclif",
    "testing"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "lib/leia.js",
  "bin": {
    "leia": "bin/leia"
  },
  "files": [
    "/bin",
    "/cli",
    "/lib",
    "/templates"
  ],
  "nyc": {
    "include": [
      "lib/*.js"
    ],
    "exclude": [
      "test/**",
      "bin/**"
    ],
    "cache": true,
    "all": true
  },
  "oclif": {
    "bin": "leia",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "check:toolchain": "bun run scripts/check-toolchain.ts",
    "dev": "bun --watch run src/cli.ts",
    "leia": "bun run src/cli.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint bin/leia . --ext .js,.ts --ignore-pattern '*.leia.js' --ignore-pattern '*.leia.cjs' --ignore-pattern '*.leia.mjs' --ignore-pattern 'leia.readme.js' --ignore-pattern dist",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "nyc --reporter=html --reporter=text mocha --timeout 5000 test/*.spec.js",
    "build": "bun run scripts/build.ts",
    "watch": "bun run scripts/build.ts --watch",
    "check:build": "bun run scripts/check-build.ts",
    "test:leia": "bun run leia README.md \"examples/**/*.md\" -i \"examples/basic-cmd-example.md\" -i \"examples/exclude-example/**/*.md\" -i \"examples/stdin-example.md\" -i \"examples/custom-headers.md\" -i \"examples/environment.md\" -i \"examples/basic-pwsh-example.md\"",
    "test:leia:stdin": "bun run leia examples/stdin-example.md --stdin"
  },
  "dependencies": {
    "@lando/argv": "^1.0.6",
    "@lando/chai": "npm:chai@^4.4.1",
    "@oclif/command": "^1.8.0",
    "@oclif/config": "^1.17.0",
    "@oclif/errors": "^1.3.5",
    "@oclif/plugin-help": "^3.2.3",
    "chalk": "^4.1.2",
    "command-line-test": "^1.0.10",
    "debug": "^4.3.2",
    "detect-newline": "^3.1.0",
    "dot": "^1.1.2",
    "fs-extra": "^7.0.1",
    "glob": "^7.1.3",
    "lodash": "^4.17.11",
    "marked": "^4.0.10",
    "mocha": "^11.1.0",
    "object-hash": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.15.8",
    "@babel/eslint-parser": "7.15.7",
    "@oclif/dev-cli": "^1.26.0",
    "@oclif/test": "^1.2.8",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "mock-fs": "^4.7.0",
    "nyc": "^15.1.0",
    "typescript": "~5.9.3",
    "@types/bun": "1.3.14",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@types/node": "^24.0.0"
  },
  "packageManager": "bun@1.3.14",
  "type": "commonjs"
}
